---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Coole Seite">
  <main class="min-h-screen bg-white">
    <section
      aria-labelledby="page-title"
      class="grid grid-cols-1 gap-x-8 gap-y-12 px-4 py-10 sm:grid-cols-2 sm:px-10 lg:grid-cols-6 lg:px-[100px] lg:py-16"
    >
      <h1 id="page-title" class="kern-heading-display col-span-full lg:col-span-2">
        Coole Seite
      </h1>

      <article class="kern-card kern-card--hug col-span-full sm:col-span-1 lg:col-span-2 lg:mt-[56px] w-full max-w-[408px] bg-white">
        <div class="kern-card__media">
          <img
            src={`${import.meta.env.BASE_URL}figma/card-image.png`}
            alt="Sonnenuntergang über dem Meer an einer felsigen Küste"
            width="406"
            height="228"
            class="aspect-video object-cover"
            loading="lazy"
          />
        </div>
        <div class="kern-card__container">
          <header class="kern-card__header">
            <p class="kern-preline">Vorzeile</p>
            <h2 class="kern-title">Titel</h2>
            <p class="kern-subline">Unterzeile</p>
          </header>
          <div class="kern-card__body">
            <p class="kern-body">Hallo, hier steht Text.</p>
          </div>
          <footer class="kern-card__footer">
            <button type="button" class="kern-btn kern-btn--primary">
              <span class="kern-label">Button 1</span>
            </button>
            <button type="button" class="kern-btn kern-btn--secondary">
              <span class="kern-label">Button 2</span>
            </button>
          </footer>
        </div>
      </article>
    </section>
  </main>
</Layout>
