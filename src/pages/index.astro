---
import Layout from "../layouts/Layout.astro"

const base = import.meta.env.BASE_URL

const cards = [
  {
    title: "Titel 1",
    text: "Hallo, hier steht Text.",
    image: "img-7f1e26ff3c438ee367dcad4ee0788a861a2fbd7e.jpg",
    alt: "Sonnenuntergang über dem Meer an einer felsigen Küste mit Leuchtturm",
  },
  {
    title: "Titel 2",
    text: "Hallo, hier steht auch Text.",
    image: "img-e44872890766b3fe69b75b3173b0805aa9eb7992.jpg",
    alt: "Dichter Regenwald mit kleinem Wasserfall",
  },
  {
    title: "Titel 3",
    text: "Hier könnte Ihre Werbung stehen",
    image: "img-a6f2faf8b70cda91ccdb574e9aa940d2ca41ffd6.jpg",
    alt: "Bergsee vor schneebedeckten Alpengipfeln mit Holzhütte",
  },
]
---

<Layout>
  <main class="bg-white px-4 py-10 sm:px-8 md:py-16 lg:px-[100px]">
    <section aria-labelledby="page-title" class="mx-auto max-w-[1240px]">
      <h1 id="page-title" class="kern-heading-display mb-8">Coole Seite v4.1</h1>

      <ul class="grid list-none grid-cols-1 items-start gap-x-8 gap-y-12 p-0 md:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((card) => (
            <li>
              <article class="kern-card kern-card--hug w-full">
                <div class="kern-card__media">
                  <img
                    src={`${base}figma/${card.image}`}
                    alt={card.alt}
                    width="406"
                    height="228"
                    loading="lazy"
                    class="aspect-video h-auto object-cover"
                  />
                </div>
                <div class="kern-card__container">
                  <header class="kern-card__header">
                    <p class="kern-preline">Vorzeile</p>
                    <h2 class="kern-title">{card.title}</h2>
                    <p class="kern-subline">Unterzeile</p>
                  </header>
                  <div class="kern-card__body">
                    <p class="kern-body">{card.text}</p>
                  </div>
                  <footer class="kern-card__footer">
                    <button type="button" class="kern-btn kern-btn--primary">
                      <span class="kern-label">Button 1</span>
                    </button>
                    <button type="button" class="kern-btn kern-btn--secondary">
                      <span class="kern-label">Button 2</span>
                    </button>
                  </footer>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
