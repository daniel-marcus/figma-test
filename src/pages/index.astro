---
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"

const base = import.meta.env.BASE_URL

const cards = [
  {
    image: `${base}figma/card-1.png`,
    imageAlt: "Sonnenuntergang über dem Meer an einer felsigen Küste",
    preline: "Vorzeile",
    title: "Titel 1",
    subline: "Unterzeile",
    body: "Hallo, hier steht Text.",
  },
  {
    image: `${base}figma/card-2.png`,
    imageAlt: "Üppiger Regenwald mit Farnen und einem kleinen Wasserfall",
    preline: "Vorzeile",
    title: "Titel 2",
    subline: "Unterzeile",
    body: "Hallo, hier steht auch Text.",
  },
]
---

<Layout>
  <main class="bg-white px-4 py-10 sm:px-8 sm:py-16 lg:px-[100px]">
    <h1 class="kern-heading-display">Coole Seite v3</h1>

    <section
      aria-label="Übersicht"
      class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-[232px] lg:grid-cols-6"
    >
      {
        cards.map((card) => (
          <article class="kern-card kern-card--hug lg:col-span-2">
            <div class="kern-card__media">
              <img
                src={card.image}
                alt={card.imageAlt}
                width="406"
                height="228"
                loading="lazy"
                class="aspect-video object-cover"
              />
            </div>
            <div class="kern-card__container">
              <header class="kern-card__header">
                <p class="kern-preline">{card.preline}</p>
                <h2 class="kern-title">{card.title}</h2>
                <p class="kern-subline">{card.subline}</p>
              </header>
              <div class="kern-card__body">
                <p class="kern-body">{card.body}</p>
              </div>
              <footer class="kern-card__footer">
                <button type="button" class="kern-btn kern-btn--primary">
                  <span class="kern-label">Button 1</span>
                </button>
                <button type="button" class="kern-btn kern-btn--secondary">
                  <span class="kern-label">Button 2</span>
                </button>
              </footer>
            </div>
          </article>
        ))
      }
    </section>
  </main>
</Layout>
